# =====================================================================
# LEXORA - Litigation Lifecycle Management Platform
# Environment Configuration
# =====================================================================
# Authentication: Azure RBAC ONLY (key-based auth is DISABLED on tenant).
# The app uses DefaultAzureCredential (az login / Managed Identity / VS Code).
# Ensure your principal has the role assignments listed in README.md.
# =====================================================================

# ---- Azure OpenAI ----
# If AZURE_OPENAI_API_KEY is set, uses key-based auth. Otherwise uses RBAC.
AZURE_OPENAI_ENDPOINT=https://<your-aoai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ---- Azure AI Search (optional, RBAC) ----
# Leave blank to use local FAISS vector store instead.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=lexora-docs

# ---- Azure AD (Entra) Tenant for RBAC ----
AZURE_TENANT_ID=<your-tenant-id>
AZURE_CLIENT_ID=<your-app-registration-client-id>
# AZURE_CLIENT_SECRET intentionally NOT used - RBAC only.

# ---- App Config ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET=change-me-to-a-long-random-string-for-session-signing
LOG_LEVEL=INFO

# ---- Storage ----
DATA_DIR=./data
DOCS_DIR=./docs
SQLITE_PATH=./data/lexora.db
VECTOR_INDEX_PATH=./data/vector_index

# ---- MCP Server ----
MCP_TRANSPORT=sse
MCP_HOST=127.0.0.1
MCP_PORT=8765

# ---- Demo Mode ----
# When true, allows role-switching from the UI (no real JWT required).
# Set to false in production to require Entra ID tokens.
DEMO_MODE=true
